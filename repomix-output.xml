  optimizeDeps: {
    // Exclude both engines to prevent Vite from disrupting
    // precompiled WebGPU shaders and WASM TVM bindings.
    exclude: ['@mlc-ai/web-llm', '@wllama/wllama', '@huggingface/transformers'],
  },
});
