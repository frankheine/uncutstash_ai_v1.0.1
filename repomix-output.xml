import { useEffect, useState, useRef } from 'react';
import { useLocalRuntime, AssistantRuntimeProvider } from "@assistant-ui/react";
import { Thread } from "./components/assistant-ui/thread";
import { ragApp, setActiveProgressCallback } from './orchestrator';
import { workers } from "./rag/pipeline";
import ProceduralBackground from './components/ProceduralBackground';
import Lenis from '@studio-freight/lenis';
import gsap from 'gsap';
import { TooltipProvider } from "@/components/ui/tooltip";

export default function App() {
    const [isReady, setIsReady] = useState(false);
    const [systemStatus, setSystemStatus] = useState("Initializing WebGPU & WASM Engines...");
    const preloaderRef = useRef<HTMLDivElement>(null);

    const [globalStatus, setGlobalStatus] = useState<string | null>(null);

    // Mount Inference Worker instantly & track global progress
    useEffect(() => {
        const handleWorkerMsg = (e: MessageEvent) => {
            if (e.data.status === 'global_progress') {
                setGlobalStatus(e.data.log);
                
                // Hide the pill shortly after it hits 100%
                if (e.data.percent === 100) {
                    setTimeout(() => setGlobalStatus(null), 3000);
                }
            }
        };

        // Accessing workers.inference spawns the worker and triggers startInitialization() immediately!
        workers.inference.addEventListener('message', handleWorkerMsg);
        
        return () => workers.inference.removeEventListener('message', handleWorkerMsg);
    }, []);

    // Initialize Smooth Scrolling (Lenis)
    useEffect(() => {
        const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical',
            gestureOrientation: 'vertical',
            smoothWheel: true,
        });

        function raf(time: number) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        return () => lenis.destroy();
    }, []);

    // Boot Sequence Simulation & Preloader Exit Animation
    useEffect(() => {
        const bootSequence = async () => {
            setTimeout(() => setSystemStatus("Compiling Orama Vector Indices..."), 1000);

            setTimeout(() => {
                if (preloaderRef.current) {
                    gsap.to(preloaderRef.current, {
                        opacity: 0,
                        scale: 1.1,
                        filter: "blur(10px)",
                        duration: 1.2,
                        ease: "power3.inOut",
                        onComplete: () => {
                            setIsReady(true);
                        }
                    });
                }
            }, 2500);
        };
        bootSequence();
    }, []);

    const runtime = useLocalRuntime({
        run: async function* ({ messages, abortSignal }) {
            try {
                const latestMessage = messages[messages.length - 1];

                const contentArray = latestMessage.content as any[];
                const queryText = typeof latestMessage.content === 'string'
                    ? latestMessage.content
                    : contentArray.find((part) => part.type === 'text')?.text || "";

                const queue: any[] = [];
                let done = false;
                let error: any = null;

                setActiveProgressCallback((msg) => {
                    queue.push(msg);
                });

                ragApp.invoke(
                    { query: queryText },
                    { signal: abortSignal }
                ).then((state) => {
                    queue.push({ type: 'done', text: state.answer });
                    done = true;
                }).catch((e) => {
                    error = e;
                    done = true;
                });

                let displayedText = "";
                let currentLog = "";

                while (!done || queue.length > 0) {
                    if (queue.length > 0) {
                        const msg = queue.shift();
                        if (msg.type === 'done') {
                            yield { content: [{ type: "text", text: msg.text }] };
                        } else if (msg.log) {
                            currentLog = msg.log;
                            yield { content: [{ type: "text", text: `${currentLog}\n\n${displayedText}` }] };
                        } else if (msg.text !== undefined) {
                            displayedText = msg.text;
                            yield { content: [{ type: "text", text: currentLog ? `${currentLog}\n\n${displayedText}` : displayedText }] };
                        }
                    } else {
                        await new Promise(r => setTimeout(r, 50));
                    }
                }

                setActiveProgressCallback(null);

                if (error) {
                    return {
                        content: [{ type: "text", text: "System error: Failed to reach the local orchestrator." }]
                    };
                }
            } catch (error) {
                console.error("LangGraph Invocation Failed:", error);
                return {
                    content: [{ type: "text", text: "System error: Failed to reach the local orchestrator." }]
                };
            }
        }
    });

    return (
        <TooltipProvider>
            <AssistantRuntimeProvider runtime={runtime}>
                <div className="relative flex h-screen w-full bg-zinc-950 overflow-hidden text-white">

                    {/* Preloader — GSAP animates this out on boot */}
                    {!isReady && (
                        <div
                            ref={preloaderRef}
                            className="absolute inset-0 z-50 flex flex-col items-center justify-center bg-zinc-950 gap-4"
                        >
                            <div className="w-16 h-16 rounded-full border-2 border-violet-500 border-t-transparent animate-spin" />
                            <p className="text-zinc-400 text-sm font-mono tracking-widest">{systemStatus}</p>
                        </div>
                    )}

                    {/* Global Engine Status Pill */}
                    {globalStatus && (
                        <div className="absolute top-4 left-1/2 -translate-x-1/2 z-40">
                            <div className="glass-panel px-4 py-2 rounded-full border border-violet-500/30 flex items-center gap-3 shadow-lg shadow-violet-500/10">
                                <div className="w-3 h-3 rounded-full bg-violet-500 animate-pulse" />
                                <span className="text-xs font-mono text-violet-200 tracking-wide">{globalStatus}</span>
                            </div>
                        </div>
                    )}

                    {/* Layer 1: The Procedural Background locked to the back */}
                    <div className="absolute inset-0 z-0 pointer-events-none">
                        <ProceduralBackground />
                    </div>

                    {/* Layer 2: The Chat Interface hovering on top */}
                    <div className="relative z-10 w-full max-w-4xl mx-auto my-6 h-[calc(100vh-3rem)] flex flex-col glass-panel rounded-3xl overflow-hidden shadow-2xl ring-1 ring-white/5">
                        <Thread />
                    </div>

                </div>
            </AssistantRuntimeProvider>
        </TooltipProvider>
    );
}
</file>

