import { StateGraph, START, END, Annotation } from "@langchain/langgraph";
import { workers, runWorker } from "./rag/pipeline";

export const GraphState = Annotation.Root({
    query: Annotation<string>(),
    context: Annotation<string>(),
    answer: Annotation<string>(),
});

type ProgressCallback = (msg: any) => void;
let activeProgressCallback: ProgressCallback | null = null;

export function setActiveProgressCallback(cb: ProgressCallback | null) {
    activeProgressCallback = cb;
}

// ── Retrieval Node ────────────────────────────────────────────────────────────
// Step 1: embed the query into a dense vector via the embeddings worker.
// Step 2: run hybrid (dense + BM25) search against the Orama index in the
//         retrieval worker, returning the top-10 candidate chunks.
// Step 3: cross-encoder rerank via the rerank worker, returning the top-5
//         highest-confidence passages as the grounded context string.
async function retrieveNode(state: typeof GraphState.State) {
    console.log("--- RETRIEVE NODE ---");

    // Push stage notifications into the active callback so the UI streaming
    // queue in App.tsx picks them up and renders them in the chat thread.
    const notify = (log: string) => {
        if (activeProgressCallback) activeProgressCallback({ status: 'progress', log });
    };

    // 1. Embed query
    notify('🔮 Embedding query vector...');
    const embedResult = await runWorker<{ embedding: number[] }>(
        workers.embed,
        { text: state.query }
    );

    // 2. Hybrid search — retrieval worker emits its own progress log before resolving
    const retrieveResult = await runWorker<{ candidates: { id: string; text: string; score: number }[] }>(
        workers.retrieve,
        {
            action: "search",
            queryText: state.query,
            queryVector: embedResult.embedding,
        }
    );

    const candidates = retrieveResult.candidates ?? [];

    if (candidates.length === 0) {
        console.warn("[Retrieve Node] No candidates found — context will be empty.");
        notify('⚠️ No matching documents found in the index.');
        return { context: "" };
    }

    notify(`📄 ${candidates.length} candidates retrieved — reranking...`);

    // 3. Cross-encoder rerank — worker emits its own progress logs before resolving
    const rerankResult = await runWorker<{ reranked: { text: string; rerankScore: number }[] }>(
        workers.rerank,
        { query: state.query, candidates }
    );

    const reranked = rerankResult.reranked ?? [];

    // Join the top passages into a single context block for the LLM
    const context = reranked.map((doc, i) => `[${i + 1}] ${doc.text}`).join("\n\n");

    notify(`✅ Context ready — ${reranked.length} passage(s) grounded. Generating answer...`);
    console.log(`[Retrieve Node] Built context from ${reranked.length} passage(s).`);
    return { context };
}

// ── Generate Node ─────────────────────────────────────────────────────────────
async function generateNode(state: typeof GraphState.State) {
    console.log("--- GENERATE NODE ---");
    try {
        // runWorker() injects its own UUID id — do not pass one manually
        const response = await runWorker<{ text: string }>(workers.inference, {
            prompt: state.query,
            context: state.context ?? "No context available.",
        }, (msg) => {
            if (activeProgressCallback) activeProgressCallback(msg);
        });

        return { answer: response.text };
    } catch (error) {
        console.error("Worker Execution Failed:", error);
        throw error;
    }
}

// ── Graph ─────────────────────────────────────────────────────────────────────
// Full pipeline: START → retrieve → generate → END
const workflow = new StateGraph(GraphState)
    .addNode("retrieve", retrieveNode)
    .addNode("generate", generateNode)
    .addEdge(START, "retrieve")
    .addEdge("retrieve", "generate")
    .addEdge("generate", END);

export const ragApp = workflow.compile();
</file>

