import { Wllama } from '@wllama/wllama';

let wllama: Wllama | null = null;

const SYSTEM_INSTRUCTIONS = `You are Frank, an elite sovereign AI assistant operating completely client-side. Protect user privacy above all else. Use the provided context to answer questions accurately and concisely.`;

// Define WASM asset paths — must match what's in /public/wasm/
// AssetsPathConfig accepts: { default, 'single-thread/wllama.wasm', 'multi-thread/wllama.wasm' }
// We only ship single-thread for now (no SharedArrayBuffer required in that mode)
const CONFIG_PATHS = {
    'single-thread/wllama.wasm': '/wasm/wllama.wasm',
    default: '/wasm/wllama.wasm',
};

let initPromise: Promise<void> | null = null;
let engineReady = false;

function startInitialization() {
    if (initPromise) return initPromise;
    
    console.log("[Inference Worker] Initializing Sovereign Wllama Engine...");
    self.postMessage({ status: 'global_progress', log: 'Initializing Sovereign AI Engine...' });

    initPromise = (async () => {
        try {
            wllama = new Wllama(CONFIG_PATHS);
            const modelUrl = new URL("/models/Qwen3-1.7B-Magic_decensored.i1-Q4_K_M.gguf", self.location.origin).href;
            
            let lastPercent = -1;
            await wllama.loadModelFromUrl(modelUrl, {
                n_ctx: 4096,
                progressCallback: ({ loaded, total }) => {
                    const percent = Math.round((loaded / total) * 100);
                    if (percent > lastPercent) {
                        lastPercent = percent;
                        self.postMessage({ status: 'global_progress', percent, log: `Downloading AI Weights: ${percent}%` });
                    }
                }
            });

            engineReady = true;
            console.log("[Inference Worker] Local GGUF Engine Online.");
            self.postMessage({ status: 'global_progress', percent: 100, log: 'Local AI Engine Online.' });
        } catch (error) {
            console.error("[Inference Worker] Engine Initialization Failed:", error);
            self.postMessage({ status: 'global_progress', percent: 0, log: `Initialization Failed: ${(error as Error).message}` });
        }
    })();

    return initPromise;
}

// Start immediately when the worker file is evaluated!
startInitialization();

self.onmessage = async (event: MessageEvent) => {
    const { prompt, context, id } = event.data;

    try {
        if (!engineReady) {
            self.postMessage({ id, status: 'progress', log: '⚙️ [Worker] Waiting for AI Engine to finish booting...' });
            await initPromise;
        }

        // Build the full ChatML-formatted prompt string
        const fullPrompt = [
            `<|im_start|>system\n${SYSTEM_INSTRUCTIONS}\nAnswer using ONLY the provided context.<|im_end|>`,
            `<|im_start|>user\nContext:\n${context}\n\nQuery:\n${prompt}<|im_end|>`,
            `<|im_start|>assistant\n`,
        ].join('\n');

        let currentResponse = '';
        await wllama.createCompletion({
            prompt: fullPrompt,
            max_tokens: 512,
            stream: true,
            onNewToken: (token, piece, currentText) => {
                currentResponse = currentText;
                self.postMessage({ id, status: 'progress', text: currentText });
            },
            stop: ['<|im_end|>'],
        });

        self.postMessage({ id, status: 'success', text: currentResponse });

    } catch (error: any) {
        console.error("[Inference Worker Error]:", error);
        self.postMessage({ id, status: 'error', message: error.message });
    }
};
